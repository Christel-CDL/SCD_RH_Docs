        "jsCode": "// Diagnostic (19/10/2026) : coller l'« ID du message » d'un e-mail, copié dans Brevo → Journaux. 204 = effacé.\n// Deux essais : avec et sans les chevrons < >, pour voir lequel Brevo accepte.\nconst id = '<COLLER ICI L ID DU MESSAGE COPIÉ DANS BREVO>';\nreturn [\n  { json: { essai: 'avec chevrons', messageId: id } },\n  { json: { essai: 'sans chevrons', messageId: id.replace(/^<|>$/g, '') } },\n];"
      },
