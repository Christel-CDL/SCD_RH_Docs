{
  "name": "SCD – Événements de l'application",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "scd-evenements",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "6b1d4c1f-0001-4d66-8b62-0000000000b1",
      "name": "Événement reçu",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "2f6b0d8e-5c1a-4e3b-9d7f-5c0d1e2f3a4b"
    },
    {
      "parameters": {
        "jsCode": "// Vérifie que l'appel vient bien de l'application : signature HMAC-SHA256 de « horodatage.corps » avec le secret\n// partagé, horodatage de moins de 5 minutes. Le corps est lu brut, octet pour octet, tel qu'il a été signé.\n// Seuls les e-mails déjà rédigés par l'application sont acceptés : n8n ne manipule jamais aucune pièce.\nconst crypto = require('crypto');\nconst entree = $input.first();\nconst entetes = entree.json.headers || {};\nconst horodatage = String(entetes['x-scd-horodatage'] || '');\nconst signature = String(entetes['x-scd-signature'] || '');\nconst brut = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst attendu = crypto.createHmac('sha256', $env.SCD_WEBHOOK_SECRET).update(`${horodatage}.${brut}`).digest('hex');\nconst a = Buffer.from(signature);\nconst b = Buffer.from(attendu);\nconst valide = a.length === b.length && crypto.timingSafeEqual(a, b) && Math.abs(Date.now() - Number(horodatage)) < 5 * 60 * 1000;\nif (!valide) return [{ json: { valide: false } }];\nconst { evenement, donnees } = JSON.parse(brut);\nif (evenement !== 'email') return [{ json: { valide: false } }];\nreturn [{ json: { valide: true, ...donnees } }];"
      },
      "id": "6b1d4c1f-0002-4d66-8b62-0000000000b2",
      "name": "Vérifier la signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valide }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6b1d4c1f-0003-4d66-8b62-0000000000b3",
      "name": "Signature valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
