      ],
      "webhookId": "7a2c1e9f-3b4d-4f6a-8c1e-2d3f4a5b6c7d",
      "notes": "Laisse à Brevo le temps de créer le journal de l'e-mail. Moins de 65 s : n8n attend en mémoire, sans rien écrire dans sa base.",
      "notesInFlow": true
    },
