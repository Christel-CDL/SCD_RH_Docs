    {
      "parameters": {
        "jsCode": "// Dossier complet : télécharge chaque PDF sur le port interne de l'application (réseau privé, secret),\n// puis prépare un élément par e-mail avec ses pièces jointes. Les PDF restent en mémoire, jamais sur le disque.\nconst secret = $env.SCD_INTERNAL_API_SECRET;\nconst { messages, confirmation, echec } = $input.first().json.donnees;\nconst sortie = [];\nfor (const message of messages) {\n  const { pieces_jointes: piecesJointes, ...reste } = message;\n  try {\n    const binary = {};\n    const noms = [];\n    for (const [i, pj] of piecesJointes.entries()) {\n      const contenu = await this.helpers.httpRequest({\n        url: pj.url,\n        headers: { Authorization: `Bearer ${secret}` },\n        encoding: 'arraybuffer',\n        timeout: 30000,\n      });\n      const cle = `pj_${i + 1}`;\n      binary[cle] = await this.helpers.prepareBinaryData(Buffer.from(contenu), pj.nom, 'application/pdf');\n      noms.push(cle);\n    }\n    sortie.push({ json: { ...reste, pieces_binaires: noms.join(','), confirmation, echec, pret: true }, binary });\n  } catch (erreur) {\n    // L'application dira à l'administratrice que l'envoi a échoué, et réessaiera plus tard.\n    sortie.push({ json: { numero: reste.numero, confirmation, echec, pret: false } });\n  }\n}\nreturn sortie;"
      },
