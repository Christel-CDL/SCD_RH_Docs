    {
      "parameters": {
        "jsCode": "// Après la réponse à l'application : on ne garde que l'identifiant Brevo de l'e-mail (ni nom, ni adresse, ni lien).\nconst id = $('Envoyer l\\'e-mail').first().json.messageId;\nreturn id ? [{ json: { messageId: id } }] : [];"
      },
