      "id": "6b1d4c1f-0001-4d66-8b62-0000000000b1",
      "name": "Événement reçu",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 200],
      "webhookId": "2f6b0d8e-5c1a-4e3b-9d7f-5c0d1e2f3a4b"
