# Copier ce fichier en .env pour le développement local (npm run dev). Ne jamais committer .env.
# En production, ces valeurs se saisissent dans hPanel (variables d'environnement du projet Docker).

# Adresse publique, sans « / » final. En production : https://pieces.expertform.fr
APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data

# Administratrice : toujours présente et active, rôle admin.
ADMIN_EMAIL=

# Nom affiché dans les pages et les e-mails.
AGENCE_NOM=Essentiel & Domicile Pessac

# Durées
SESSION_HOURS=8
LOGIN_LINK_MINUTES=15

# n8n (instance dédiée). Le secret signe chaque appel (HMAC-SHA256) : 64 caractères aléatoires,
# par exemple : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Développement uniquement : affiche les liens de connexion dans la console au lieu de les envoyer.
# Refusé au démarrage si NODE_ENV=production.
DEV_LOG_LINKS=1

# Derrière Traefik uniquement (déjà réglé dans l'image Docker).
# TRUST_PROXY=1
